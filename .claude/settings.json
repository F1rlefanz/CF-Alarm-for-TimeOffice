{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python tools/schleuse/pruefe_schleuse.py",
            "if": "Bash(git *)",
            "timeout": 900,
            "onFailure": "block",
            "statusMessage": "Schleuse prueft..."
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python tools/schleuse/pruefe_schleuse.py",
            "if": "PowerShell(git *)",
            "timeout": 900,
            "onFailure": "block",
            "statusMessage": "Schleuse prueft..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python tools/skills/pruefe_skills.py --hook",
            "timeout": 30,
            "statusMessage": "Pruefe Skill-Frontmatter..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python tools/doku/pruefe_budget.py --hook",
            "timeout": 20,
            "statusMessage": "Pruefe Doku-Budget..."
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python tools/sitzungsstart.py",
            "timeout": 20,
            "statusMessage": "Projektstand wird abgeleitet..."
          }
        ]
      }
    ]
  }
}
