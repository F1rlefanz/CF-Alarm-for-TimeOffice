<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup-Regeln fuer Android 6.0-11 (API 23-30).
   Fuer Android 12+ (API 31+) gilt data_extraction_rules.xml.

   BEIDE DATEIEN MUESSEN INHALTLICH IDENTISCH BLEIBEN. Sonst sichert dasselbe Geraet je
   nach Android-Version Unterschiedliches, und ein Fehler faellt nur auf einer Haelfte der
   Installationsbasis auf. Die Gleichheit erzwingt BackupRulesConsistencyTest; die volle
   Begruendung je Ausschluss steht in data_extraction_rules.xml im Block <cloud-backup>.

   GRUNDSATZ: Gesichert wird nur, was der Nutzer selbst konfiguriert hat (Schichten,
   Dimm-/DND-/Hue-Regeln, Kalenderauswahl). Anmelde- und Verschluesselungsartefakte sind
   geraetegebunden und bleiben draussen.

   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Alle DataStore-Dateien (settings, shift_prefs, hue_settings, calendar_selection_prefs).
         master_pause_enabled und calendar_unavailable_* behandelt DeviceLocalFlagsGuard beim
         Geraetewechsel (Master-Pause via MasterPauseUseCase.resume()). -->
    <include domain="file" path="datastore"/>

    <!-- AUSSCHLUSS 1 - Token-Store: Masterkey im Keystore des alten Geraets, hier unentschluesselbar. -->
    <exclude domain="file" path="datastore/token_data_v2_encrypted.preferences_pb"/>

    <!-- AUSSCHLUSS 2 - Anmeldezustand: login_status=true ohne gueltiges Token kennt das Auth-Gate nicht. -->
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>

    <!-- SharedPreferences: Domain aufgenommen, damit die folgenden <exclude>-Regeln wirksam
         (und Lint-konform) sind. WER EINE NEUE SharedPreferences-DATEI ANLEGT, muss hier
         bewusst entscheiden, ob sie ins Backup darf. -->
    <include domain="sharedpref" path="."/>

    <!-- AUSSCHLUSS 3 - Tink-Keyset: geraetegebunden, Sicherheitsartefakt. -->
    <exclude domain="sharedpref" path="token_encryption_prefs.xml"/>

    <!-- AUSSCHLUSS 4 - Bridge-ID-Pinning: geraete- und netzspezifisch. -->
    <exclude domain="sharedpref" path="hue_trust_pinning.xml"/>

    <!-- Diagnosedaten des alten Geraets. -->
    <exclude domain="sharedpref" path="background_services.xml"/>

    <!-- Eigenschaft der Hardware (Weckbildschirm-Verdraengung), nicht der Nutzerkonfiguration. -->
    <exclude domain="sharedpref" path="weckbildschirm_verdraengung.xml"/>
</full-backup-content>
