<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration fuer CFAlarm

    WAS DIESE DATEI TUT (und was NICHT):
    Sie erzwingt fuer den gesamten App-Traffic HTTPS gegen den System-Trust-Store. Mehr nicht.

    Die TLS-Entscheidung fuer die LOKALE Philips-Hue-Bridge trifft diese Datei NICHT - die
    liegt bewusst im eigenen OkHttp-TrustManager:
      hue/network/HueTrustManager.kt (Trust-Modell + Hostname-Verifier fuer RFC-1918/
      Link-Local-Adressen, Bridge-ID-Pinning nur als Audit-Layer) - verdrahtet in
      HueApiClient (.sslSocketFactory(...) + .hostnameVerifier(...)).
    Ein per sslSocketFactory gesetzter TrustManager umgeht die Network-Security-Config
    vollstaendig. Wer den TrustManager in HueApiClient entfernt oder durch OkHttp-Defaults
    ersetzt, verliert JEDE Bridge-Verbindung - diese Datei faengt das nicht auf.

    WARUM DER FRUEHERE <domain-config>-BLOCK ENTFERNT WURDE (2026-08):
    Er trug 21 <domain>-Eintraege als IP-PRAEFIXE ("10.", "172.16." ... "192.168.",
    "169.254.") und wollte damit RFC-1918-Ausnahmen inkl. <certificates src="user"/>
    definieren. Androids Network-Security-Config kennt aber KEIN Praefix-/Wildcard-Matching:
    ein <domain>-Wert wird als vollstaendiger Hostname (bzw. mit includeSubdomains als
    DNS-Suffix) verglichen. "192.168." hat die echte Bridge-IP 192.168.x.y also nie
    getroffen - der ganze Block war wirkungslos und behauptete im Header eine Absicherung,
    die faktisch im Code sitzt. Falls hier je wieder eine XML-Ausnahme gebraucht wird:
    nur EXAKTE, konkrete IPs eintragen, Praefixe sind kein gueltiges Konstrukt.

    cleartextTrafficPermitted="false" bleibt (passend zu android:usesCleartextTraffic="false"
    im Manifest) - verifiziert: es gibt keinen einzigen "http://"-Aufruf im Code.
-->
<network-security-config>
    <!--
        Fuer allen App-Traffic: HTTPS gegen den System-Trust-Store
        (ueber Google Play Services automatisch aktualisiert, inkl. Sperrpruefung).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!--
        Nur in Debug-Builds (android:debuggable="true"): zusaetzlich nutzereigene
        Zertifikate, damit sich der Traffic bei Bedarf mit einem lokalen Proxy
        (z. B. mitmproxy/Charles) mitlesen laesst. In Release-Builds unwirksam.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
