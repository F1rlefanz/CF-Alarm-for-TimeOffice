    <string name="dimmer_rule_intensity">Intensität dieser Regel</string>
    <string name="dimmer_rule_intensity_hint">Gilt für die Fenster dieser Regel. Wellness nutzt die globale Darstellung.</string>
    <string name="dimmer_rule_save">Speichern</string>
    <string name="dimmer_rule_delete">Regel löschen</string>
    <string name="dimmer_appearance_hint">Verdunkelung und Wärme dieser Wellness-Abdunkelung. Schicht-Regeln haben je eigene Werte (im Regel-Editor).</string>
