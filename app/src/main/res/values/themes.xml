<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Parent bleibt Theme.AppCompat.* (AppCompatActivity-Kompatibilität).
         Corporate Design: generische holo-Farben durch Markenrot ersetzt. -->
    <style name="Theme.CFAlarmForTimeOffice" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/brand_red_dark</item>
        <item name="colorAccent">@color/brand_red</item>
    </style>

    <!-- Alarm-Vollbildschirm: kräftiges Markenrot statt generischem Blau —
         zugleich dringlich (Alarm) und wiedererkennbar (Corporate Design). -->
    <style name="Theme.CFAlarmForTimeOffice.AlarmFullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/brand_red_dark</item>
        <item name="colorAccent">@color/off_white</item>
        <item name="android:windowBackground">@color/brand_red</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
