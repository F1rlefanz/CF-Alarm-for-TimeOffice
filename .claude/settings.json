{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/skills/pruefe_skills.py --hook",
            "timeout": 30,
            "statusMessage": "Pruefe Skill-Frontmatter..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/doku/pruefe_budget.py --hook",
            "timeout": 20,
            "statusMessage": "Pruefe Doku-Budget..."
          }
        ]
      }
    ]
  }
}
