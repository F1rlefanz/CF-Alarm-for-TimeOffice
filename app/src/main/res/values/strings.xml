    <!-- Schicht-Dimmer (AccessibilityService) -->
    <string name="dim_accessibility_label">CF-Alarm Schicht-Dimmer</string>
    <string name="dim_accessibility_desc">Legt eine abdunkelnde Schicht über den Bildschirm, um dich vor Schichtbeginn zum Herunterfahren zu bringen. Der Dienst liest keine Bildschirminhalte und wertet keine Eingaben aus – er dient ausschließlich der Verdunkelung.</string>

    <!-- Dimmer-Tab -->
    <string name="dimmer_header">Schicht-Dimmer</string>
    <string name="dimmer_intro">Dunkelt den Bildschirm vor deiner nächsten Schicht automatisch ab und blendet ihn zur Weckzeit wieder auf – damit du leichter herunterfährst.</string>
    <string name="dimmer_wellness">Wellness (Wind-down)</string>
    <string name="dimmer_wellness_hint">Dunkelt eine Weile vor jeder Weckzeit ab – unabhängig von Regeln, wie ein sanfter Übergang.</string>
    <string name="dimmer_rules">Schicht-Regeln</string>
    <string name="dimmer_rules_hint">Dimmt nach frei definierbaren Regeln, gekoppelt an deine erkannten Schichten (z. B. nachts, aber nicht an Nachtdienst-Nächten).</string>
    <string name="dimmer_manage_rules">Regeln verwalten</string>

