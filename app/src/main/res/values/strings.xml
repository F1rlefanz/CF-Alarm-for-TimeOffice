    <!-- Schicht-Dimmer (AccessibilityService) -->
    <string name="dim_accessibility_label">CF-Alarm Schicht-Dimmer</string>
    <string name="dim_accessibility_desc">Legt eine abdunkelnde Schicht über den Bildschirm, um dich vor Schichtbeginn zum Herunterfahren zu bringen. Der Dienst liest keine Bildschirminhalte und wertet keine Eingaben aus – er dient ausschließlich der Verdunkelung.</string>

    <!-- Dimmer-Tab -->
    <string name="dimmer_header">Schicht-Dimmer</string>
    <string name="dimmer_intro">Dunkelt den Bildschirm zu deinen Zeiten ab – damit du leichter herunterfährst. Alles läuft über Regeln: eine Regel legt fest, an welchen Tagen sie gilt, welche Zeitfenster sie dimmt und wie dunkel und warm es dabei wird.</string>
    <string name="dimmer_enabled">Dimmen</string>
    <string name="dimmer_enabled_hint">Hauptschalter für die Bildschirm-Verdunkelung. Ist er aus, dimmt nichts – auch keine Regel.</string>
    <string name="dimmer_rules_explain">Ohne Regel wird nie gedimmt. Jede Nacht dimmst du z. B. mit einer Regel für „Alle Tage (Universal)“ und einem Fenster von 22:00 bis „Weckzeit, spätestens“ 07:00. Eine Einschlafhilfe nur vor der Schicht ist ein Fenster von 60 Minuten vor der Weckzeit bis zur Weckzeit. Eine Regel ohne Fenster nimmt ihre Tage vom Dimmen aus.</string>
    <string name="dimmer_manage_rules">Regeln verwalten</string>
    <string name="dimmer_preview_timeline_hint">Zeigt, wann in den nächsten Tagen tatsächlich gedimmt wird – so siehst du, ob deine Regeln greifen.</string>
    <string name="dimmer_preview_timeline">Vorschau (nächste Tage)</string>

    <!-- Dimmer-Vorschau-Zeitleiste -->
    <string name="dimmer_preview_title">Dimm-Vorschau</string>
    <string name="dimmer_preview_empty">Kein Dimmen in den nächsten Tagen geplant.</string>
    <string name="dimmer_preview_row">%1$s · Verdunkelung %2$d %%</string>

    <!-- Dimm-Regeln: Liste + Editor -->
    <string name="dimmer_rules_title">Dimm-Regeln</string>
    <string name="dimmer_rules_empty">Noch keine Regeln. Tippe auf +, um eine anzulegen.</string>
    <string name="dimmer_rule_unnamed">(ohne Name)</string>
    <!-- Schnellstart: legt eine SICHTBARE Regel an, kein eingebautes Verhalten. Die Texte sagen
         das ausdruecklich ("kannst du danach anpassen oder loeschen") - der abgeloeste
         Nacht-Standard wirkte, ohne in dieser Liste zu stehen, und genau das soll nicht
         zurueckkommen. -->
    <string name="dimmer_quickstart_title">Schnellstart</string>
    <string name="dimmer_quickstart_hint">Legt eine fertige Regel an. Sie steht danach in dieser Liste und lässt sich anpassen oder löschen – es entsteht nichts Unsichtbares.</string>
    <string name="dimmer_quickstart_night">Nacht-Dimmen anlegen</string>
    <string name="dimmer_quickstart_night_hint">Für alle Tage: 22:00 bis „Weckzeit, spätestens“ 07:00.</string>
    <string name="dimmer_quickstart_night_rulename">Nacht-Dimmen</string>
    <string name="dimmer_quickstart_nightshift">Nachtdienst-Rhythmus anlegen</string>
    <string name="dimmer_quickstart_nightshift_hint">Zwei Fenster am selben Tag: Vormittagsschlaf ab Schichtende bis 14:00 und Nickerchen von 15:00 bis zur Weckzeit. Die Nacht selbst bleibt hell – da bist du im Dienst.</string>
    <string name="dimmer_quickstart_nightshift_rulename">Nachtdienst-Rhythmus: %1$s</string>
    <string name="dimmer_quickstart_exclude">Schicht ausnehmen</string>
    <string name="dimmer_quickstart_exclude_hint">Regel ohne Fenster: an Tagen dieser Schicht wird nicht gedimmt.</string>
    <string name="dimmer_quickstart_exclude_rulename">Ohne Dimmen: %1$s</string>
    <string name="dimmer_quickstart_pick_shift">Für welche Schicht?</string>
    <string name="dimmer_quickstart_no_shifts">Noch keine Schichten erkannt. Lege zuerst unter „Schichten“ eine an – dann kannst du eine Regel darauf setzen.</string>
    <string name="dimmer_quickstart_cancel">Abbrechen</string>
    <string name="dimmer_quickstart_exists_title">Dafür gibt es schon eine Regel</string>
    <string name="dimmer_quickstart_exists_body">»%1$s« gilt bereits für dieselben Tage. Pro Tag wirkt nur eine Regel — eine zweite daneben würde nie greifen. Öffne stattdessen die vorhandene Regel und passe sie an.</string>
    <string name="dimmer_quickstart_exists_open">Vorhandene Regel öffnen</string>
    <!-- Kein <plurals>: "Fenster" lautet im Deutschen in Singular UND Plural gleich - eine
         Pluralform waere ein kuenstlicher, wortgleicher Zweig ohne Nutzen. -->
    <string name="dimmer_rule_subtitle" tools:ignore="PluralsCandidate">%1$s · %2$d Fenster</string>
    <string name="dimmer_rule_off">aus</string>
    <string name="dimmer_pattern_free">Freie Tage (keine Schicht)</string>
    <string name="dimmer_pattern_universal">Alle Tage (Universal)</string>
    <string name="dimmer_rule_editor_title">Regel bearbeiten</string>
    <string name="dimmer_rule_name">Name</string>
    <string name="dimmer_rule_shift">Gilt für</string>
    <string name="dimmer_rule_enabled">Aktiv</string>
    <string name="dimmer_rule_windows">Zeitfenster</string>
    <string name="dimmer_rule_add_window">+ Fenster</string>
    <string name="dimmer_rule_no_windows_hint">Ohne Fenster wird an passenden Tagen NICHT gedimmt – so nimmst du z. B. Nachtdienst-Nächte von einer Universal-Regel aus.</string>
    <string name="dimmer_window_start">Start</string>
    <string name="dimmer_window_end">Ende</string>
