<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- 
    ============================================
    CFAlarm für TimeOffice - Lint Konfiguration
    ============================================
    
    Diese Datei unterdrückt bekannte False Positives und passt die Lint-Prüfungen
    an die spezifischen Anforderungen unserer App an.

    WICHTIG: Nur Issue-IDs eintragen, die es wirklich gibt. Lint meldet jede unbekannte ID
    als UnknownIssueId-Warnung - und zwar einmal pro geprüfter Variante, also mehrfach.
    Vor August 2026 standen hier drei erfundene IDs (HardcodedCredentials, UnencryptedIntent,
    LeakCanary), die allein 18 der damals 50 Lint-Warnungen erzeugten, ohne irgendetwas zu
    bewirken. Neue Einträge deshalb immer mit `./gradlew --offline lintDebug` gegenprüfen.

    Letzte Aktualisierung: August 2026
    -->

    <!-- ================= KRITISCHE FALSE POSITIVES ================= -->
    
    <!-- 
    BatteryLife: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
    Begründung: Wir verwenden dies nur in createBatteryOptimizationIntent(),
    welches einen Intent zurückgibt aber NICHT direkt ausführt.
    Der User muss aktiv zustimmen. Dies ist Play Store konform.
    -->
    <issue id="BatteryLife">
        <!-- PHASE 2 CLEANUP: BatteryOptimizationManager.kt removed (obsoleted by BatteryOptimizationHelper) -->
    </issue>
    
    <!-- 
    CustomX509TrustManager: Philips Hue Bridge Zertifikat-Handling
    Begründung: Wird ausschließlich für die lokale Kommunikation mit der 
    Philips Hue Bridge verwendet (selbst-signierte Zertifikate).
    Nicht für Internet-Kommunikation genutzt.

    Certificate Pinning: MEHRFACH VERSUCHT, GESCHEITERT
    Status: Auf unbestimmte Zeit verschoben
    Grund: Nur lokale WLAN-Kommunikation mit Hue Bridge
    Risiko: Akzeptabel - kein Internet-Traffic betroffen
    Hinweis: Falls wieder Zeit investiert wird - vorherige Ansätze siehe Git History

    Dateiname: Der TrustManager heißt HueTrustManager.kt. Bis August 2026 stand hier
    "TrustAllCertificatesManager.kt" - eine Datei, die es im Repo längst nicht mehr gibt;
    die Unterdrückung griff also für nichts, und die einzige dokumentierte Begründung für
    den bewussten Trust-Bypass hing an einem Namen, den niemand mehr findet.
    -->
    <issue id="CustomX509TrustManager">
        <ignore path="**/HueTrustManager.kt" />
    </issue>
    
    <!-- ================= DEPENDENCY UPDATES ================= -->
    
    <!-- 
    NewerVersionAvailable: Bibliotheks-Updates
    Begründung: Wir updaten Dependencies bewusst und kontrolliert,
    nicht automatisch bei jeder Minor-Version.
    Severity auf "informational" reduziert statt "warning"
    -->
    <issue id="NewerVersionAvailable" severity="informational" />
    
    <!-- 
    GradleDependency: Ähnlich wie NewerVersionAvailable
    -->
    <issue id="GradleDependency" severity="informational" />
    
    <!-- ================= LINT VITAL RELEASE CHECKS ================= -->
    
    <!--
    TrustAllX509TrustManager: leere checkClientTrusted/checkServerTrusted in einer Bibliothek

    Gemessen am 25.08.2026 (Aufräum-Runde 9): die beiden Treffer stammen aus
    google-http-client-2.2.0.jar, NICHT aus dem HueTrustManager der App - der validiert
    echt und wirft bei Fehlschlag. Bis dahin stand hier, es gehe um Apache Commons
    Logging / Log4JLogger; das war falsch, und der <ignore regexp> darunter trifft
    entsprechend nichts. Wirksam ist allein das severity="informational".
    Der tote regexp ist als Issue #31 vorgemerkt, nicht hier nebenbei entfernt.
    -->
    <issue id="TrustAllX509TrustManager" severity="informational">
        <ignore regexp=".*org\.apache\.commons\.logging\.impl\.Log4JLogger.*" />
    </issue>
    
    <!-- 
    InvalidPackage: Apache Commons Logging's optional dependencies
    Begründung: org.apache.commons.logging hat optionale Abhängigkeiten 
    zu Log4J, die für die Android-Plattform nicht erforderlich sind.
    -->
    <issue id="InvalidPackage">
        <ignore regexp=".*org\.apache\.commons\.logging.*" />
        <ignore regexp=".*org\.apache\.log4j.*" />
    </issue>
    
    <!-- ================= SDK VERSION CHECKS ================= -->
    
    <!-- 
    ObsoleteSdkInt: Unnötige SDK Version Checks
    Begründung: Unsere minSdk ist 26, aber manche Checks bleiben für
    Kompatibilität mit älteren Bibliotheken.
    -->
    <issue id="ObsoleteSdkInt" severity="informational" />
    
    <!-- ================= RESSOURCEN ================= -->
    
    <!-- 
    UnusedResources: Ungenutzte Ressourcen
    Begründung: Manche Ressourcen sind für zukünftige Features vorbereitet
    (z.B. OnePlus-spezifische Strings). Severity reduziert.
    -->
    <issue id="UnusedResources" severity="informational" />
    
    <!-- ================= CODE STYLE ================= -->
    
    <!-- 
    SetTextI18n: Hardcoded Text Concatenation
    Begründung: Für Debug-Ausgaben und technische Werte akzeptabel
    -->
    <issue id="SetTextI18n" severity="informational" />
    
    <!-- 
    HardcodedText: Ähnlich wie SetTextI18n
    nur in Debug-Builds relevant
    -->
    <issue id="HardcodedText" severity="informational" />
    
    <!-- ================= PERFORMANCE ================= -->
    
    <!-- 
    UseValueOf: Number Boxing Performance
    Nicht kritisch für unsere App-Größe
    -->
    <issue id="UseValueOf" severity="informational" />
    
    <!-- 
    UseSparseArrays: HashMap vs SparseArray
    HashMap ist oft lesbarer, Performance-Unterschied minimal
    -->
    <issue id="UseSparseArrays" severity="informational" />
    
    <!-- ================= ACCESSIBILITY ================= -->
    
    <!-- 
    ContentDescription: Fehlende Bildbeschreibungen
    TODO: Später für bessere Accessibility hinzufügen
    -->
    <issue id="ContentDescription" severity="informational" />
    
    <!-- ================= AKTIVIERTE PRÜFUNGEN (STRENGER) ================= -->
    
    <!-- 
    Diese Checks wollen wir STRENGER haben:
    -->
    
    <!-- Sicherheitsprobleme immer als Error.
         HardcodedCredentials und UnencryptedIntent standen hier bis August 2026, sind aber
         keine existierenden Lint-Issue-IDs (frei erfunden) - entfernt, sie erzeugten nur
         UnknownIssueId-Warnungen. -->
    <issue id="InsecureBaseConfiguration" severity="error" />
    <issue id="WorldReadableFiles" severity="error" />
    <issue id="WorldWriteableFiles" severity="error" />

    <!-- Memory Leaks als Error.
         "LeakCanary" ist ebenfalls keine Lint-Issue-ID (LeakCanary ist eine Bibliothek, die
         hier gar nicht eingebunden ist) - entfernt. -->
    <issue id="StaticFieldLeak" severity="error" />
    
    <!-- Crash-Risiken als Error -->
    <issue id="NullSafeMutableLiveData" severity="error" />
    <issue id="FragmentLiveDataObserve" severity="error" />
    
    <!-- ================= BASELINE ================= -->

    <!--
    Es gibt BEWUSST keine Baseline-Datei.

    Bis August 2026 lag ein app/lint-baseline.xml im Repo, das ausschließlich 27
    FullBackupContent-Einträge zu <exclude>-Zeilen enthielt, die es in backup_rules.xml /
    data_extraction_rules.xml längst nicht mehr gibt - und das obendrein nie gelesen wurde,
    weil `baseline = file("lint-baseline.xml")` in build.gradle.kts auskommentiert war. Toter
    Ballast, der 27 unterdrückte Backup-Sicherheitsprobleme vortäuschte. Datei gelöscht,
    Kommentar in build.gradle.kts entsprechend korrigiert.

    Falls später wirklich eine Baseline gebraucht wird: frisch erzeugen UND in
    build.gradle.kts aktivieren - nicht halb. Die alte Datei nicht wiederbeleben.
    -->
    
</lint>