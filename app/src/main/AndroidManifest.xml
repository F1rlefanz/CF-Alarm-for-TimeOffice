<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Explicitly block AD_ID permission by setting maxSdkVersion to 0
         AD_ID is not used for advertising/analytics - CF Alarm is exclusively a shift-based alarm application
         Blocking this permission prevents unnecessary data collection -->
    <uses-permission 
        android:name="com.google.android.gms.permission.AD_ID" 
        android:maxSdkVersion="0" 
        tools:node="replace"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware,ProtectedPermissions" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Erforderlich fuer die Hue-Bridge-Kommunikation ab Android 17+ (API 37+) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- USE_FULL_SCREEN_INTENT: Required to display full-screen alarm UI over lock screen and during deep sleep
         Core alarm functionality - users expect to be awakened by highly visible notifications for work shifts
         AlarmFullScreenActivity displays critical alarms with wake locks to ensure visibility -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- USE_EXACT_ALARM: Required for precise shift-based alarm scheduling
         Core functionality - alarms must trigger within seconds of configured shift start times
         Shift workers cannot accept minute-level tolerance for work start notifications
         App targets nurses, healthcare workers, and other shift professionals -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- FOREGROUND_SERVICE types required by Android 12+ (declared in manifest for Android 14+ compliance)
         MEDIA_PLAYBACK: AlarmSoundService plays shift notification sounds in foreground during night hours
         SPECIAL_USE: AlarmMaintenanceService performs periodic 6-hourly calendar sync and alarm recreation
         Visibility: Service notifications inform user of background alarm maintenance activities -->
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:ignore="ProtectedPermissions" />
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="ProtectedPermissions" />

    <!-- BEWUSST ENTFERNTE PERMISSIONS - nicht "sicherheitshalber" zurueckholen, sondern nur
         gegen eine echte, nachgewiesene Code-Nutzung:

         SYSTEM_ALERT_WINDOW und DISABLE_KEYGUARD: im Code ungenutzt. Der Full-Screen-Alarm
         laeuft ueber USE_FULL_SCREEN_INTENT + showWhenLocked/turnScreenOn. SYSTEM_ALERT_WINDOW
         ist zudem Play-Review-sensibel, DISABLE_KEYGUARD seit API 26 wirkungslos.

         ACCESS_WIFI_STATE und CHANGE_WIFI_MULTICAST_STATE (entfernt August 2026): Altlast aus der
         Zeit vor dem NsdManager-Umbau. Die mDNS-Bridge-Suche laeuft ueber Androids
         NsdManager (HueMdnsDiscoveryService) - der Systemdienst haelt seinen Multicast-Lock
         selbst, die App braucht dafuer keine Wifi-Permission. Per Grep verifiziert: kein
         WifiManager, kein MulticastLock, kein MulticastSocket, kein WIFI_SERVICE im Baum.
         ACCESS_WIFI_STATE galt vor Android 8 zusaetzlich als standortnaher Signalgeber und
         ist deshalb ueberdurchschnittlich Play-Review-auffaellig.

         MODIFY_AUDIO_SETTINGS (entfernt August 2026): ebenfalls ungenutzt. AlarmSoundService holt
         nur den AudioManager und nutzt requestAudioFocus()/abandonAudioFocusRequest() - beides
         permissionsfrei; der Ton laeuft ueber MediaPlayer mit AudioAttributes.USAGE_ALARM. Die
         permissionspflichtigen APIs (setMode/setRingerMode/adjust*Volume/setStreamVolume/
         setSpeakerphoneOn/setMicrophoneMute/startBluetoothSco) kommen im Code nicht vor. -->

    <!-- Package-Sichtbarkeit fuer TimeOffice (Android 11+): CFAlarms Alarme haengen an einem
         Kalender, den die TimeOffice-App lokal befuellt (siehe TimeOfficeHealthHelper) - ohne
         diese Deklaration liefert getPackageInfo() fuer das fremde Package immer
         NameNotFoundException, egal ob TimeOffice installiert ist. -->
    <queries>
        <package android:name="de.pradtke.timeoffice" />
    </queries>

    <application
        android:name=".CFAlarmApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CFAlarmForTimeOffice"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="34"> <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.CFAlarmForTimeOffice">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

        <activity
            android:name=".AlarmFullScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CFAlarmForTimeOffice.AlarmFullScreen"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:directBootAware="true"
            android:lockTaskMode="if_whitelisted" />


        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".alarm.receiver.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <!-- WICHTIG: BOOT_COMPLETED, LOCKED_BOOT_COMPLETED und MY_PACKAGE_REPLACED werden
                 OHNE Daten-URI gesendet. Ein <data>-Element im Filter wuerde sie komplett
                 aussperren (der Data-Test schlaegt fehl) und den Receiver de facto totlegen. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Kein directBootAware: Zeitzonen-Events setzen ein entsperrtes, laufendes System
             voraus, anders als Boot. TIMEZONE_CHANGED steht wie BOOT_COMPLETED auf Androids
             Ausnahmeliste der impliziten-Broadcast-Einschraenkungen seit API 26 - Manifest-
             Registrierung funktioniert ohne Laufzeit-Registrierung. -->
        <receiver
            android:name=".alarm.receiver.TimezoneChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.AlarmSoundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:directBootAware="true"
            android:stopWithTask="false" />

        <!-- Alarm Maintenance Service (6-hourly background maintenance) -->
        <service
            android:name=".service.AlarmMaintenanceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Periodic shift-based alarm synchronization" />
        </service>

        <!-- Alarm Maintenance Receiver (receives Exact Alarm triggers) -->
        <receiver
            android:name=".service.AlarmMaintenanceBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Schicht-Dimmer: Bedienungshilfen-Dienst, der die Dimm-Schicht traegt.
             Liest keine Bildschirminhalte (siehe dim_accessibility_service_config).
             Bis zur manuellen Aktivierung durch den Nutzer inaktiv. -->
        <service
            android:name=".dimmer.DimAccessibilityService"
            android:exported="false"
            android:label="@string/dim_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dim_accessibility_service_config" />
        </service>

        <!-- Schicht-Dimmer: rollender Zeitplan-Tick (Dimm-Fenster an/aus). -->
        <receiver
            android:name=".dimmer.DimScheduleReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Schicht-Dimmer: bedient die Aktions-Buttons der Korrektur-Notification (Feature C).
             Leichtgewichtig, bewusst KEIN Foreground-Service - jeder Aufruf ist eine kurze
             DataStore-Operation plus ein Tick-Nachvollzug, kein Prozess-Am-Leben-Halten noetig. -->
        <service
            android:name=".dimmer.DimNotificationService"
            android:enabled="true"
            android:exported="false" />

        <!-- DND-Steuerung: rollender Zeitplan-Tick (Nicht-stoeren-Regel an/aus). -->
        <receiver
            android:name=".dnd.DndScheduleReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>