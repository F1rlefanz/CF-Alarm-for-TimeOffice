    <string name="dimmer_open_accessibility">Bedienungshilfen-Dienst aktivieren</string>
    <string name="dimmer_disclosure_title">Was dieser Dienst tut</string>
    <string name="dimmer_disclosure_body">Der Schicht-Dimmer nutzt einen Android-Bedienungshilfen-Dienst ausschließlich, um eine abdunkelnde Schicht über den Bildschirm zu legen. Er liest keine Bildschirminhalte, erfasst keine Eingaben und sendet keine Daten. Du kannst ihn jederzeit in den Android-Einstellungen wieder abschalten.</string>
    <!-- Sitzt im dismissButton-Slot des Offenlegungs-Dialogs, tut also NICHTS ausser schliessen.
         "Verstanden" hat in diesem Projekt die Bedeutung "bestaetigen/weiter" (siehe OEM-Hinweis in
         CLAUDE.md) - genau daneben steht der Knopf, der wirklich weiterfuehrt. Zwei Knoepfe, von
         denen einer wie eine Bestaetigung klingt und nichts tut, sind eine Falle. -->
    <string name="dimmer_disclosure_understood">Abbrechen</string>

    <!-- DND-Einstellungen (Nicht stören automatisch schaltbar) -->
    <string name="dnd_header">Nicht stören</string>
    <string name="dnd_intro">Schaltet Android\'s "Nicht stören"-Modus automatisch nach Schicht – dein Wecker klingelt trotzdem, er umgeht Nicht-stören immer.</string>
    <string name="dnd_follow_dimmer">Schlaf-Fenster folgt dem Dimmer</string>
    <string name="dnd_follow_dimmer_hint">Nicht stören ist an, während der Schicht-Dimmer dimmt – die Zeiten kommen 1:1 aus deiner Dimmer-Konfiguration.</string>
    <string name="dnd_during_shift">Während der Dienstzeit</string>
    <string name="dnd_during_shift_hint">Nicht stören ist an von Schichtbeginn bis Schichtende (laut Kalender-Termin, nicht der Weckzeit).</string>
    <string name="dnd_during_shift_exceptions">Ausnahmen (kein Nicht-stören während des Diensts)</string>
    <string name="dnd_permission_required">Benachrichtigungszugriff erforderlich</string>
    <string name="dnd_permission_hint">Android verlangt eine einmalige Freigabe, damit die App Nicht-stören steuern darf. Suche in der folgenden Liste nach "CFAlarm" – ein direkter Sprung zur App ist bei dieser Android-Einstellung leider nicht möglich.</string>
    <string name="dnd_permission_grant">Freigabe erteilen</string>
    <string name="dnd_unsupported">Nicht verfügbar auf diesem Android (benötigt Android 11 oder neuer).</string>
    <string name="dnd_status_title">Nicht-stören-Steuerung</string>
    <string name="dnd_status_ok">Freigabe erteilt – die App kann Nicht-stören steuern</string>
    <string name="dnd_status_missing">Keine Freigabe – Nicht-stören-Regeln bleiben wirkungslos</string>

    <!-- DND: konfigurierbare Policy (was genau stummgeschaltet wird) -->
    <string name="dnd_policy_title">Was wird stummgeschaltet?</string>
    <string name="dnd_policy_hint">Gilt für beide Auslöser oben. Dein eigener Wecker klingelt immer, unabhängig von diesen Einstellungen.</string>
    <string name="dnd_policy_calls">Anrufe</string>
    <string name="dnd_policy_repeat_callers">Wiederholte Anrufer durchlassen</string>
    <string name="dnd_policy_repeat_callers_hint">Ein zweiter Anruf derselben Person kurz nacheinander gilt als dringend und klingelt trotzdem – für Erreichbarkeit im Notfall.</string>
    <string name="dnd_policy_messages">Nachrichten</string>
    <string name="dnd_policy_conversations">Gespräche</string>
    <string name="dnd_policy_conversations_hint">Priorisierte Chat-Unterhaltungen, z. B. hervorgehobene Kontakte in Messenger-Apps.</string>
    <string name="dnd_policy_reminders">Erinnerungen</string>
    <string name="dnd_policy_events">Termine</string>
    <string name="dnd_policy_system">System-Töne</string>
    <string name="dnd_policy_media">Medien (Musik, Podcasts, Videos)</string>
    <string name="dnd_policy_media_hint">Aus lässt laufende Wiedergabe unangetastet.</string>
    <string name="dnd_policy_alarms">Wecker anderer Apps</string>
    <string name="dnd_policy_alarms_hint">Betrifft nur fremde Wecker-/Alarm-Apps – der Wecker dieser App klingelt immer, unabhängig davon.</string>
