    <string name="dnd_permission_required">Benachrichtigungszugriff erforderlich</string>
    <string name="dnd_permission_hint">Android verlangt eine einmalige Freigabe, damit die App Nicht-stören steuern darf. Suche in der folgenden Liste nach "CFAlarm" – ein direkter Sprung zur App ist bei dieser Android-Einstellung leider nicht möglich.</string>
    <string name="dnd_permission_grant">Freigabe erteilen</string>
